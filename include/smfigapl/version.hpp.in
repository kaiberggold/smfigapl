/// @file version.hpp
/// @brief Version of the library (generated by CMake from the project version).
///
/// The API follows semantic versioning (see @ref versioning): MAJOR for
/// incompatible changes of the public headers, the domain model, the
/// problem codes or the meaning of a result; MINOR for additions; PATCH for
/// fixes without API change. Only source compatibility is promised.

#pragma once

#include <cstdint>
#include <string_view>

namespace smfigapl
{
    /// Major version at compile time.
    inline constexpr std::uint32_t VERSION_MAJOR = @PROJECT_VERSION_MAJOR@;
    /// Minor version at compile time.
    inline constexpr std::uint32_t VERSION_MINOR = @PROJECT_VERSION_MINOR@;
    /// Patch version at compile time.
    inline constexpr std::uint32_t VERSION_PATCH = @PROJECT_VERSION_PATCH@;
    /// The prerelease part at compile time: empty in a release, e.g.
    /// "devel.4" in a development build.
    inline constexpr std::string_view VERSION_PRERELEASE@SM_VERSION_PRERELEASE_INIT@;
    /// "MAJOR.MINOR.PATCH", with "-PRERELEASE" in a development build.
    inline constexpr std::string_view VERSION_STRING = "@SM_VERSION_STRING@";

    /// A version number.
    struct Version
    {
        std::uint32_t major = 0; ///< Incompatible changes of the API.
        std::uint32_t minor = 0; ///< Additions (before 1.0: also changes).
        std::uint32_t patch = 0; ///< Fixes.
        friend constexpr bool operator==(const Version&, const Version&) = default;
    };

    /// The version of the library the program runs with (it may differ from
    /// the headers it was compiled with if the library is replaced).
    [[nodiscard]] Version version() noexcept;
}
